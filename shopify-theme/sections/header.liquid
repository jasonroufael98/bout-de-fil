{%- assign menu = linklists[section.settings.menu] -%}
{%- assign overlay = false -%}
{%- if section.settings.overlay_on_home and template.name == 'index' -%}
  {%- assign overlay = true -%}
{%- endif -%}

<header class="site-header{% if overlay %} site-header--overlay{% endif %}" id="top">
  <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} — {{ 'general.home' | t }}">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'logo__img', alt: shop.name, widths: '200, 400' }}
    {%- else -%}
      {{ section.settings.logo_text | default: shop.name }}
    {%- endif -%}
  </a>

  <nav class="nav" id="site-nav" aria-label="{{ 'general.primary_navigation' | t }}">
    <ul class="nav__list">
      {%- if menu != blank and menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          <li><a class="nav__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- endfor -%}
      {%- else -%}
        <li><a class="nav__link" href="{{ routes.all_products_collection_url }}">{{ 'general.nav_fallback.shop' | t }}</a></li>
        <li><a class="nav__link" href="{{ routes.collections_url }}">{{ 'general.nav_fallback.collection' | t }}</a></li>
        <li><a class="nav__link" href="{{ routes.root_url }}#story">{{ 'general.nav_fallback.story' | t }}</a></li>
      {%- endif -%}
    </ul>
  </nav>

  <div class="header-actions">
    {%- if section.settings.show_cart -%}
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart_label' | t: count: cart.item_count }}">
        <svg class="icon-bag" viewBox="0 0 32 38" width="32" height="38" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.2 11.5h25.6c.7 0 1.3.6 1.3 1.3l-.9 21.4c-.1 1.6-1.4 2.8-3 2.8H5.8c-1.6 0-2.9-1.2-3-2.8L1.9 12.8c0-.7.6-1.3 1.3-1.3Z"/>
          <path d="M10.5 15.5V9.2C10.5 5.8 12.9 3 16 3s5.5 2.8 5.5 6.2v6.3"/>
        </svg>
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    {%- endif -%}
    <button class="menu-toggle" type="button" aria-label="{{ 'general.open_menu' | t }}" data-open-label="{{ 'general.open_menu' | t }}" data-close-label="{{ 'general.close_menu' | t }}" aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span>
    </button>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Create Shop / Collection / Our Story links under Online Store → Navigation."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Bout de Fil"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Optional. Replaces the logo text."
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "overlay_on_home",
      "label": "Overlay header on the home page hero",
      "default": true
    }
  ]
}
{% endschema %}
