{%- liquid
  assign heading_lines = section.settings.heading | escape | newline_to_br | split: '<br />'
  assign lead = section.settings.lead | escape | newline_to_br | replace: '<br />', '<br class="br-desktop">'
  assign image = section.settings.image
  assign link = section.settings.button_link
-%}

<section class="hero" aria-labelledby="hero-title-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="hero__media">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 2000
        | image_tag:
          class: 'hero__img',
          widths: '800, 1200, 1600, 2000',
          sizes: '(max-width: 860px) 100vw, 60vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image_alt
      }}
    {%- else -%}
      <img class="hero__img"
           src="{{ 'hero-fallback.svg' | asset_url }}"
           alt="{{ section.settings.image_alt | escape }}"
           width="1000" height="900" fetchpriority="high">
    {%- endif -%}
  </div>

  <div class="hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow"><span>{{ section.settings.eyebrow | escape }}</span></p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hero__title" id="hero-title-{{ section.id }}">
        {%- for line in heading_lines -%}
          {%- assign clean_line = line | strip -%}
          {%- if clean_line != blank -%}<span>{{ clean_line }}</span>{%- endif -%}
        {%- endfor -%}
      </h1>
    {%- endif -%}

    <div class="hero__body">
      {%- if section.settings.lead != blank -%}
        <p class="hero__lead">{{ lead }}</p>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <p class="hero__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ link | default: routes.all_products_collection_url }}">
          <span class="btn__label">{{ section.settings.button_label | escape }}</span>
          <svg class="btn__arrow" viewBox="0 0 40 12" width="40" height="12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 6h37M33 1l5 5-5 5"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Landscape photo (≈1600×1440) with a cream background on its right edge so it blends into the page. If empty, the bundled illustration is shown."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Two fringed knot handbags, one burgundy jacquard and one zebra print, on a cream bouclé chair"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Drop 01"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "One line per row.",
      "default": "The Fringe\nCollection"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Tagline",
      "info": "Line breaks apply on larger screens only.",
      "default": "Handcrafted bags with movement,\ntexture, and fun silhouettes."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Limited releases."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Drop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
